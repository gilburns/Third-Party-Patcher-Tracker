---
import Base from '../../layouts/Base.astro';
import { apps, formatDate, iconSrc, isUrl, metadataIconUrl, metadataPlistUrl } from '../../lib/apps.js';
import CopyButton from '../../components/CopyButton.astro';

export function getStaticPaths() {
  return apps.map((app) => ({ params: { label: app.label }, props: { app } }));
}

const { app } = Astro.props;
const latest = app.versions[0];
const linkLabels = { homepage: 'Website', documentation: 'Documentation', privacy: 'Privacy policy' };
const hasIntel = app.versions.some((v) => v.downloadURLi386);
---
<Base title={app.name} description={app.description || `Version history for ${app.name}.`}>
  <p class="crumbs"><a href="/browse/">Browse</a> / <a href={`/browse/?category=${encodeURIComponent(app.category)}`}>{app.category}</a></p>

  <section class="card head">
    <img class="icon" src={iconSrc(app, 256)} alt="" width="112" height="112" />
    <div class="head-text">
      <h1>{app.name}</h1>
      {app.publisher && <p class="muted publisher">{app.publisher}</p>}
      <p class="latest">
        Latest <strong class="version">{latest.version}</strong>{' '}
        <span class="muted">· seen {formatDate(latest.timeStamp)}</span>
      </p>
      {app.description && <p class="desc">{app.description} <CopyButton value={app.description} what="description" /></p>}
      {Object.keys(app.links).length > 0 && (
        <p class="links">
          {Object.entries(app.links).map(([k, url]) => <a href={url} rel="noopener">{linkLabels[k] ?? k}</a>)}
        </p>
      )}
    </div>
  </section>

  <section class="facts card">
    <dl>
      <div><dt>Installomator label</dt><dd><code>{app.label}</code><CopyButton value={app.label} what="label" /></dd></div>
      <div><dt>Category</dt><dd><a href={`/browse/?category=${encodeURIComponent(app.category)}`}>{app.category}</a></dd></div>
      {app.bundleId && <div><dt>Bundle ID</dt><dd><code>{app.bundleId}</code><CopyButton value={app.bundleId} what="bundle ID" /></dd></div>}
      {latest.teamID && <div><dt>Team ID</dt><dd><code>{latest.teamID}</code><CopyButton value={latest.teamID} what="team ID" /></dd></div>}
      {latest.type && <div><dt>Package type</dt><dd>{latest.type}</dd></div>}
      {app.blockingProcesses.length > 0 && <div><dt>Blocking processes</dt><dd>{app.blockingProcesses.join(', ')}</dd></div>}
    </dl>
    {app.keywords.length > 0 && (
      <p class="keywords">
        {app.keywords.map((k) => <a class="chip" href={`/browse/?q=${encodeURIComponent(k)}`}>{k}</a>)}
      </p>
    )}
    {(app.hasMetadata || app.hasIcon) && (
      <p class="files">
        {app.hasMetadata && (
          <a class="file-btn" href={metadataPlistUrl(app.label)} data-save-as={`${app.label}.plist`}>
            <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M10 3v9m0 0-3.5-3.5M10 12l3.5-3.5M4 15.5h12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Metadata plist
          </a>
        )}
        {app.hasIcon && (
          <a class="file-btn" href={metadataIconUrl(app.label)} data-save-as={`${app.label}.png`}>
            <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M10 3v9m0 0-3.5-3.5M10 12l3.5-3.5M4 15.5h12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Original icon (PNG)
          </a>
        )}
        <span class="muted small">From <a href="https://github.com/gilburns/Installomator-Metadata">Installomator-Metadata</a></span>
      </p>
    )}
  </section>

  <section>
    <h2>Version history</h2>
    <p class="muted note">
      {app.versions.length} {app.versions.length === 1 ? 'version' : 'versions'} recorded.
      "Seen" is when the tracker first found the version, not the vendor's release date.
      A version without a download link belongs to a label whose link always serves the latest release.
    </p>
    {app.staticUrl && (
      <div class="card callout">
        <strong>This label's download link always serves the latest version.</strong>{' '}
        {app.versions.length === 1
          ? 'The tracker used to replace the previous version each time a new one appeared, so this is the only version recorded so far. New versions will be added here as they appear, and only the newest one will have a download link.'
          : <>
              Only the newest entry has a download link. Older entries show when each version was seen,
              but the link now serves the latest version instead.
              {app.historyReplaced && ` Versions found before ${formatDate(app.versions.at(-1).timeStamp)} weren't recorded.`}
            </>}
      </div>
    )}
    <div class="card table-wrap">
      <table>
        <thead>
          <tr>
            <th>Version</th>
            <th>Seen</th>
            <th>Download</th>
          </tr>
        </thead>
        <tbody>
          {app.versions.map((v) => (
            <tr>
              <td class="version">
                {v.version}
                {v.firstSeen && app.versions.length > 1 && <span class="chip new">First seen</span>}
              </td>
              <td class="nowrap" title={v.timeStamp}>{formatDate(v.timeStamp)}</td>
              <td><div class="downloads">
                {isUrl(v.downloadURL) && (
                  <a href={v.downloadURL} rel="nofollow noopener">{hasIntel ? 'Apple silicon' : 'Download'}{v.type && ` (${v.type})`}</a>
                )}
                {isUrl(v.downloadURLi386) && (
                  <a href={v.downloadURLi386} rel="nofollow noopener">Intel{v.type && ` (${v.type})`}</a>
                )}
                {!isUrl(v.downloadURL) && !isUrl(v.downloadURLi386) && (
                  <span class="muted" title="The download link now serves a newer version">No longer available</span>
                )}
              </div></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Base>

<script>
  // Save the Installomator-Metadata files instead of opening them: raw.githubusercontent.com
  // allows cross-origin fetches, and a blob URL lets the download attribute name the file.
  // If the fetch fails, the link falls back to opening the raw file.
  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-save-as]')) {
    link.addEventListener('click', async (e) => {
      e.preventDefault();
      try {
        const res = await fetch(link.href);
        if (!res.ok) throw new Error(String(res.status));
        const url = URL.createObjectURL(await res.blob());
        const a = Object.assign(document.createElement('a'), { href: url, download: link.dataset.saveAs });
        document.body.append(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 10000);
      } catch {
        window.location.href = link.href;
      }
    });
  }
</script>

<style>
  .crumbs { margin: 0 0 12px; font-size: 13px; color: var(--muted); }
  .head { display: flex; gap: 20px; padding: 20px; align-items: flex-start; }
  .head-text { min-width: 0; }
  .head h1 { font-size: 26px; margin-bottom: 2px; }
  .publisher { margin: 0 0 8px; }
  .latest { margin: 0 0 10px; }
  .desc { margin: 0 0 10px; max-width: 70ch; }
  .links { display: flex; flex-wrap: wrap; gap: 6px 16px; margin: 0; }
  @media (max-width: 560px) {
    .head { flex-direction: column; }
    .head .icon { width: 80px; height: 80px; }
  }

  .facts { margin: 16px 0 28px; padding: 16px 20px; }
  .facts dl { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px 24px; margin: 0; }
  .facts dt { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
  .facts dd { margin: 2px 0 0; overflow-wrap: anywhere; }
  .keywords { display: flex; flex-wrap: wrap; gap: 6px; margin: 14px 0 0; }
  .facts dd code { margin-right: 2px; }
  .files { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; margin: 16px 0 0; padding-top: 14px; border-top: 1px solid var(--border); }
  .file-btn {
    display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 8px;
    border: 1px solid var(--border); background: var(--bg); color: var(--text); font-size: 14px;
  }
  .file-btn:hover { text-decoration: none; border-color: var(--accent); color: var(--accent); }
  .small { font-size: 13px; }

  h2 { font-size: 20px; }
  .note { margin: 0 0 10px; font-size: 13px; max-width: 80ch; }
  .callout { margin: 0 0 12px; padding: 12px 16px; font-size: 14px; border-left: 3px solid var(--accent); }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 10px 14px; border-bottom: 1px solid var(--border); vertical-align: top; }
  tbody tr:last-child td { border-bottom: 0; }
  th { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; font-weight: 600; }
  td.version { font-weight: 500; max-width: 360px; }
  td.version .chip { margin-left: 6px; }
  .nowrap { white-space: nowrap; }
  .downloads { display: flex; flex-wrap: wrap; gap: 4px 14px; }
</style>
